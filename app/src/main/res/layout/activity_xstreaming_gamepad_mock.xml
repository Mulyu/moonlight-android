<?xml version="1.0" encoding="utf-8"?>
<!--
  Mock screen for the ported XStreaming touch controller.

  The dark backdrop stands in for the video surface a real integration would
  render underneath the overlay; the HUD reports what the pad is emitting so the
  layout and feel can be checked without a running stream.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/xstreaming_mock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101014">

    <TextView
        android:id="@+id/xstreaming_mock_backdrop_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0.35"
        android:text="@string/xstreaming_mock_backdrop"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />

    <com.limelight.binding.input.virtual_controller.xstreaming.XStreamingGamepadView
        android:id="@+id/xstreaming_mock_gamepad"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD: live state readout plus the knobs worth trying out. -->
    <LinearLayout
        android:id="@+id/xstreaming_mock_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="#B3000000"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/xstreaming_mock_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="260dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/xstreaming_mock_sticks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFB0B0B0"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/xstreaming_mock_stick_mode"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />

            <Button
                android:id="@+id/xstreaming_mock_haptics"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/xstreaming_mock_opacity_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFB0B0B0"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/xstreaming_mock_opacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:max="100" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
